# Copy to .env.local and fill in. Never commit .env.local — it holds live secrets.

# --- Admin login ---
ADMIN_EMAIL=admin@radesign.info
# Generate with: npm run admin:hash    (the plaintext password is never stored)
ADMIN_PASSWORD_HASH=scrypt:REPLACE_SALT_HEX:REPLACE_KEY_HEX
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret   # openssl rand -hex 32

# --- Content database (MongoDB Atlas; the free M0 tier is enough) ---
# Atlas > Connect > Drivers. Remember to allowlist the server's IP under Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=radesign

# --- Image hosting (Cloudinary; the free tier is enough) ---
# Cloudinary dashboard > Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
